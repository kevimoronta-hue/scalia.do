{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "node scripts/build-locales.mjs",
  "installCommand": "npm install --omit=dev",
  "outputDirectory": ".",
  "cleanUrls": false,
  "functions": {
    "api/*.js": {
      "maxDuration": 30
    }
  },
  "trailingSlash": true,
  "rewrites": [
    {
      "source": "/meeting/:token/",
      "destination": "/api/meeting?t=:token"
    },
    {
      "source": "/meeting/:token",
      "destination": "/api/meeting?t=:token"
    }
  ],
  "redirects": [
    {
      "source": "/:lang(es|en|fr)/privacy{/}?",
      "destination": "/confidentialite/?lang=:lang",
      "permanent": true
    },
    {
      "source": "/privacidad{/}?",
      "destination": "/confidentialite/?lang=es",
      "permanent": true
    },
    {
      "source": "/privacy{/}?",
      "destination": "/confidentialite/?lang=en",
      "permanent": true
    },
    {
      "source": "/:lang(es|en|fr)/terms{/}?",
      "destination": "/mentions-legales/?lang=:lang",
      "permanent": true
    },
    {
      "source": "/terminos{/}?",
      "destination": "/mentions-legales/?lang=es",
      "permanent": true
    },
    {
      "source": "/terms{/}?",
      "destination": "/mentions-legales/?lang=en",
      "permanent": true
    },
    {
      "source": "/:lang(es|en|fr)/:old(contact|contacto|about|projects|proyectos|services|servicios){/}?",
      "destination": "/:lang/",
      "permanent": true
    },
    {
      "source": "/:old(sobre-nosotros|proyectos|contacto|servicios){/}?",
      "destination": "/es/",
      "permanent": true
    },
    {
      "source": "/:old(contact|about|projects|services){/}?",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/server/:path*",
      "destination": "/introuvable/",
      "permanent": false
    },
    {
      "source": "/middleware.js",
      "destination": "/introuvable/",
      "permanent": false
    },
    {
      "source": "/scripts/:path*",
      "destination": "/introuvable/",
      "permanent": false
    },
    {
      "source": "/package-lock.json",
      "destination": "/introuvable/",
      "permanent": false
    },
    {
      "source": "/package.json",
      "destination": "/introuvable/",
      "permanent": false
    },
    {
      "source": "/node_modules/:path*",
      "destination": "/introuvable/",
      "permanent": false
    },
    {
      "source": "/api/(.*)\\.(js|mjs|cjs)",
      "destination": "/introuvable/",
      "permanent": false
    },
    {
      "source": "/vercel.json",
      "destination": "/introuvable/",
      "permanent": false
    },
    {
      "source": "/:path(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.scalia.do"
        }
      ],
      "destination": "https://scalia.do/:path",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/((?!admin/).*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self)"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://fast.wistia.com; media-src 'self' https://embed-ssl.wistia.com; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), fullscreen=(self)"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-/x7W7R75k8Roq0WaVRQX9blP4OufE5xbAdzklGxsgpw='; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://vercel.com/api/blob/; media-src 'self' https://embed-ssl.wistia.com; frame-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/fr/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/en/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/es/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/scalians/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/mentions-legales/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/confidentialite/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/assets/fonts/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/portal/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/api/portal(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
