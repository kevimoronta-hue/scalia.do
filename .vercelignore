# Repository documentation is not part of the website.
README.md
BRIEF.md
.gitignore
.vercelignore

# Local tooling and documentation, not part of the deployment.
# (server/ is required by the /api functions and must stay deployed.)
# build-locales.mjs is the build step (vercel.json buildCommand); /scripts/
# is never served (redirect in vercel.json).
scripts/*
!scripts/build-locales.mjs
.env.example
