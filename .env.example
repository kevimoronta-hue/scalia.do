# ==========================================================================
# Scalia Booking · server-side settings
# Copy to .env.local for local tests (never committed), and set the same
# names in Vercel → Project → Settings → Environment Variables.
# Nothing here is ever sent to the browser.
# ==========================================================================

# ---- Google: choose ONE of the two ways ---------------------------------

# A. Recommended (Google Workspace): a service account with domain-wide
#    delegation, acting as the Scalia mailbox that owns the calendar.
#    Scopes to allow in Workspace Admin → Security → API controls →
#    Domain-wide delegation, for the service account's client ID:
#      https://www.googleapis.com/auth/calendar.events
#      https://www.googleapis.com/auth/calendar.freebusy
#      https://www.googleapis.com/auth/gmail.send
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# The "private_key" of the service account JSON, on one line with \n.
GOOGLE_PRIVATE_KEY=
GOOGLE_IMPERSONATE=contact@scalia.do

# B. Alternative: OAuth client + refresh token of the calendar owner.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# ---- Calendar -------------------------------------------------------------
# Calendar that receives bookings ("primary" = main calendar of the account).
GOOGLE_CALENDAR_ID=primary
# Other calendars whose events should also block slots (comma separated).
GOOGLE_BUSY_CALENDARS=
# Scalia's working zone; opening hours are set in server/config.js.
BOOKING_TIMEZONE=America/Santo_Domingo
# Set to "off" to book without a Google Meet link.
BOOKING_MEET=on

# ---- Emails ---------------------------------------------------------------
# Sent through Gmail as the account above (gmail.send). To use Resend
# instead, set RESEND_API_KEY and verify scalia.do in Resend first.
BOOKING_FROM=contact@scalia.do
BOOKING_NOTIFY=contact@scalia.do
RESEND_API_KEY=

# ---- Meeting links -------------------------------------------------------
# Dedicated key that signs the client's /meeting/<token>/ links (HMAC-SHA256).
# Long random value, e.g. `openssl rand -hex 32`. Required: without it no
# meeting link is produced or accepted.
MEETING_LINK_SECRET=

# ---- Reminders --------------------------------------------------------------
# Bearer secret expected by /api/reminders (Google Cloud Scheduler).
CRON_SECRET=

# ---- Local tests only -----------------------------------------------------
# 1 = use a local test calendar (ignored on Vercel). Emails are written as
# .eml files in the OS temp folder instead of being sent.
BOOKING_MOCK=

# Applications (/join/): short internal summary of the answers (OpenAI).
# Server only (Vercel), never in the browser or the repository. Both are
# needed: without either, the summary is simply "unavailable" and the
# application still goes through. OPENAI_MODEL: a model ID from your OpenAI
# project, no default in the code.
OPENAI_API_KEY=
OPENAI_MODEL=

# ---- Client portal (/portal, /admin) · Supabase ---------------------------
# Supabase → Project Settings → API. Server only: never in the browser.
# Database schema + Row Level Security: server/portal/schema.sql (SQL Editor).
SUPABASE_URL=
# Publishable ("anon") key: every portal call runs with the user's own
# session, so Row Level Security decides what each person sees.
SUPABASE_ANON_KEY=
# Secret ("service_role") key: ONLY used to create invitation and
# new-password links (Auth admin API). Never sent anywhere else.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: base URL of the links in portal emails (default: https://scalia.do
# in production, the preview URL on previews, this machine locally).
PORTAL_SITE_URL=

# ---- Client portal · local tests only --------------------------------------
# 1 = local test backend (no Supabase), refused on Vercel. Emails are written
# as .eml files in the OS temp folder. See PORTAL.md.
PORTAL_MOCK=
